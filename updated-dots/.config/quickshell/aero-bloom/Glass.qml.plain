import QtQuick
import QtQuick.Effects

// Frosted card: blurs the wallpaper behind itself, tints it, and draws a hairline
// frame with small thorn crosses at the corners.
Item {
    id: g
    property var core
    property Item wall
    property string label: ""
    property real tint: 0.5
    default property alias content: body.data

    Item {
        id: frost
        anchors.fill: parent
        // Over a scene wallpaper (drawn by another program) there is nothing here to
        // blur; use a darker tint instead.
        visible: !g.core.live && !g.core.video.length
        layer.enabled: true
        layer.effect: MultiEffect {
            blurEnabled: true
            blur: 1.0
            blurMax: 48
            saturation: -0.6
        }
        ShaderEffectSource {
            anchors.fill: parent
            sourceItem: g.wall
            live: true
            recursive: false
            sourceRect: {
                // Re-read when the card moves or the screen changes.
                var _ = [g.x, g.y, g.width, g.height, g.wall ? g.wall.width : 0]
                if (!g.wall) return Qt.rect(0, 0, 0, 0)
                var r = g.mapToItem(g.wall, 0, 0, g.width, g.height)
                return Qt.rect(r.x, r.y, r.width, r.height)
            }
        }
    }
    Rectangle {
        anchors.fill: parent
        color: "#0c0b0d"
        opacity: g.core.live || g.core.video.length ? Math.max(0.62, g.tint) : g.tint
    }
    Rectangle {
        anchors.fill: parent
        color: "transparent"
        border.width: 1
        border.color: g.core.pal.edge
    }

    // Thorn crosses on the corners
    Repeater {
        model: [[0, 0], [1, 0], [0, 1], [1, 1]]
        delegate: Item {
            required property var modelData
            x: modelData[0] * g.width - 5
            y: modelData[1] * g.height - 5
            width: 10; height: 10
            Rectangle { anchors.centerIn: parent; width: 10; height: 1; color: g.core.pal.muted }
            Rectangle { anchors.centerIn: parent; width: 1; height: 10; color: g.core.pal.muted }
            Rectangle { anchors.centerIn: parent; width: 3; height: 3; rotation: 45; color: g.core.pal.petal }
        }
    }

    // Label set into the top edge
    Rectangle {
        visible: g.label.length > 0
        x: 18; y: -8
        width: lab.implicitWidth + 14; height: 16
        color: "#0c0b0d"
        Text {
            id: lab
            anchors.centerIn: parent
            text: g.label
            font.family: g.core.pal.mono; font.pixelSize: 10; font.letterSpacing: 3
            color: g.core.pal.petal
        }
    }

    Item {
        id: body
        anchors.fill: parent
    }
}
