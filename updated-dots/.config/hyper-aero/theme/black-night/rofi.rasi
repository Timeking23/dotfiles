

* {
    ink:       #0d0d0d;
    graphite:  #616262;
    chrome:    #cecfd0;
    cobalt:    #4f5259;
    blue:      #6d7279;
    sky:       #90979c;
    cloud:     #eceded;

    background-color: transparent;
    text-color:       @ink;
    spacing:          0;
}

window {
    width:            660px;
    border:           1px;
    border-color:     #0d0d0dcc;
    border-radius:    22px;
    background-color: #f7f8f8c8;
    background-image: linear-gradient(to bottom, #ffffffee, #f7f8f8c0, #ecededb8);
}

mainbox {
    children: [ box-header, inputbar, listview, mode-switcher ];
    spacing:  14px;
    padding:  18px 20px 20px 20px;
}

box-header {
    orientation: horizontal;
    expand:      false;
    children:    [ textbox-title, textbox-brand ];
    padding:     0 4px 8px 4px;
    border:      0 0 1px 0;
    border-color: #61626255;
}

textbox-title {
    content:    "NEXUS // APPLICATION INDEX";
    font:       "JetBrainsMono Nerd Font Bold 9";
    text-color: @graphite;
}

textbox-brand {
    content:          "◢ HYPER·AERO";
    font:             "Michroma 9";
    text-color:       @cobalt;
    expand:           false;
    horizontal-align: 1;
}

inputbar {
    children:         [ textbox-orb, prompt, entry, num-filtered-rows, textbox-slash, num-rows ];
    spacing:          12px;
    padding:          6px 16px 6px 6px;
    border:           1px;
    border-color:     @ink;
    border-radius:    26px;
    background-color: #ffffffe6;
}

textbox-orb {
    content:          "◢";
    font:             "JetBrainsMono Nerd Font Bold 14";
    expand:           false;
    padding:          9px 14px;
    border:           1px;
    border-color:     @ink;
    border-radius:    22px;
    text-color:       #ffffff;
    background-color: @cobalt;
    background-image: linear-gradient(to bottom, #bcc0c4, #90979c, #4f5259, #6d7279);
    vertical-align:   0.5;
}

prompt {
    font:           "Michroma 9";
    text-color:     @graphite;
    vertical-align: 0.5;
}

entry {
    font:              "Exo 2 15";
    placeholder:       "Search the station…";
    placeholder-color: #61626299;
    cursor:            text;
    vertical-align:    0.5;
}

num-filtered-rows,
textbox-slash,
num-rows {
    font:           "JetBrainsMono Nerd Font 10";
    text-color:     @graphite;
    expand:         false;
    vertical-align: 0.5;
}

textbox-slash {
    content: "/";
}

listview {
    columns:      5;
    lines:        3;
    fixed-height: true;
    fixed-columns: true;
    flow:         horizontal;
    cycle:        true;
    scrollbar:    false;
    spacing:      8px;
    padding:      14px 0 0 0;
    border:       1px dash 0px 0px 0px;
    border-color: #61626277;
}

element {
    orientation:   vertical;
    padding:       14px 6px 10px 6px;
    spacing:       8px;
    border:        1px;
    border-color:  transparent;
    border-radius: 16px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @ink;
}

element selected.normal {
    border-color:     @ink;
    background-color: @cobalt;
    background-image: linear-gradient(to bottom, #bcc0c4, #90979c, #4f5259, #6d7279);
    text-color:       #ffffff;
}

element normal.active,
element alternate.active {
    text-color: @cobalt;
}

element selected.active {
    background-color: @cobalt;
    text-color:       #ffffff;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: #c4283b;
}

element-icon {
    size:             40px;
    horizontal-align: 0.5;
    cursor:           inherit;
}

element-text {
    font:             "Exo 2 10";
    horizontal-align: 0.5;
    text-color:       inherit;
    cursor:           inherit;
}

mode-switcher {
    spacing: 8px;
}

button {
    font:          "JetBrainsMono Nerd Font Bold 9";
    padding:       7px 0;
    border:        1px;
    border-color:  #61626255;
    border-radius: 14px;
    text-color:    @graphite;
    background-color: #ffffff99;
    cursor:        pointer;
}

button selected {
    border-color:     @ink;
    background-color: @cobalt;
    background-image: linear-gradient(to bottom, #bcc0c4, #90979c, #4f5259, #6d7279);
    text-color:       #ffffff;
}

message {
    padding:          10px 14px;
    border:           1px;
    border-color:     #61626255;
    border-radius:    14px;
    background-color: #ffffffb0;
}

textbox {
    text-color: @ink;
}

* {
    ink:       #ededee;
    graphite:  #959698;
    chrome:    #393a3d;
    cobalt:    #90979c;
    blue:      #6d7279;
    sky:       #45d9f0;
    cloud:     #212223;
    text-color: @ink;
}

configuration {
    icon-theme: "Papirus-Dark";
}

window {
    border-color:     #45d9f059;
    background-color: #121213d9;
    background-image: linear-gradient(to bottom, #2e2f31f0, #18191ae0, #121213d8);
}

box-header {
    border-color: #95969840;
}

textbox-brand {
    text-color: #45d9f0;
}

inputbar {
    border-color:     #45d9f073;
    background-color: #0c0c0de6;
}

textbox-orb {
    border-color:     #45d9f0b3;
    background-image: linear-gradient(to bottom, #bcc0c4, #90979c, #4f5259, #6d7279);
}

entry {
    placeholder-color: #95969899;
}

listview {
    border-color: #95969855;
}

element selected.normal {
    border-color:     #45d9f0cc;
    background-image: linear-gradient(to bottom, #bcc0c4, #90979c, #4f5259, #6d7279);
    text-color:       #ffffff;
}

element normal.active,
element alternate.active {
    text-color: #45d9f0;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: #ff5d6c;
}

button {
    border-color:     #95969840;
    background-color: #ededee12;
}

button selected {
    border-color:     #45d9f0cc;
    background-image: linear-gradient(to bottom, #bcc0c4, #90979c, #4f5259, #6d7279);
    text-color:       #ffffff;
}

message {
    border-color:     #95969840;
    background-color: #0c0c0db3;
}
