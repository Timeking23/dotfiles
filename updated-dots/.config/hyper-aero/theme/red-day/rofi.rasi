

* {
    ink:       #100c0c;
    graphite:  #725c5f;
    chrome:    #decace;
    cobalt:    #a51119;
    blue:      #dd1f41;
    sky:       #ee698e;
    cloud:     #f6eaed;

    background-color: transparent;
    text-color:       @ink;
    spacing:          0;
}

window {
    width:            660px;
    border:           1px;
    border-color:     #100c0ccc;
    border-radius:    22px;
    background-color: #faf7f8c8;
    background-image: linear-gradient(to bottom, #ffffffee, #faf7f8c0, #f6eaedb8);
}

mainbox {
    children: [ box-header, inputbar, listview, mode-switcher ];
    spacing:  14px;
    padding:  18px 20px 20px 20px;
}

box-header {
    orientation: horizontal;
    expand:      false;
    children:    [ textbox-title, textbox-brand ];
    padding:     0 4px 8px 4px;
    border:      0 0 1px 0;
    border-color: #725c5f55;
}

textbox-title {
    content:    "NEXUS // APPLICATION INDEX";
    font:       "JetBrainsMono Nerd Font Bold 9";
    text-color: @graphite;
}

textbox-brand {
    content:          "◢ HYPER·AERO";
    font:             "Michroma 9";
    text-color:       @cobalt;
    expand:           false;
    horizontal-align: 1;
}

inputbar {
    children:         [ textbox-orb, prompt, entry, num-filtered-rows, textbox-slash, num-rows ];
    spacing:          12px;
    padding:          6px 16px 6px 6px;
    border:           1px;
    border-color:     @ink;
    border-radius:    26px;
    background-color: #ffffffe6;
}

textbox-orb {
    content:          "◢";
    font:             "JetBrainsMono Nerd Font Bold 14";
    expand:           false;
    padding:          9px 14px;
    border:           1px;
    border-color:     @ink;
    border-radius:    22px;
    text-color:       #ffffff;
    background-color: @cobalt;
    background-image: linear-gradient(to bottom, #f8aac0, #ee698e, #a51119, #dd1f41);
    vertical-align:   0.5;
}

prompt {
    font:           "Michroma 9";
    text-color:     @graphite;
    vertical-align: 0.5;
}

entry {
    font:              "Exo 2 15";
    placeholder:       "Search the station…";
    placeholder-color: #725c5f99;
    cursor:            text;
    vertical-align:    0.5;
}

num-filtered-rows,
textbox-slash,
num-rows {
    font:           "JetBrainsMono Nerd Font 10";
    text-color:     @graphite;
    expand:         false;
    vertical-align: 0.5;
}

textbox-slash {
    content: "/";
}

listview {
    columns:      5;
    lines:        3;
    fixed-height: true;
    fixed-columns: true;
    flow:         horizontal;
    cycle:        true;
    scrollbar:    false;
    spacing:      8px;
    padding:      14px 0 0 0;
    border:       1px dash 0px 0px 0px;
    border-color: #725c5f77;
}

element {
    orientation:   vertical;
    padding:       14px 6px 10px 6px;
    spacing:       8px;
    border:        1px;
    border-color:  transparent;
    border-radius: 16px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @ink;
}

element selected.normal {
    border-color:     @ink;
    background-color: @cobalt;
    background-image: linear-gradient(to bottom, #f8aac0, #ee698e, #a51119, #dd1f41);
    text-color:       #ffffff;
}

element normal.active,
element alternate.active {
    text-color: @cobalt;
}

element selected.active {
    background-color: @cobalt;
    text-color:       #ffffff;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: #c4283b;
}

element-icon {
    size:             40px;
    horizontal-align: 0.5;
    cursor:           inherit;
}

element-text {
    font:             "Exo 2 10";
    horizontal-align: 0.5;
    text-color:       inherit;
    cursor:           inherit;
}

mode-switcher {
    spacing: 8px;
}

button {
    font:          "JetBrainsMono Nerd Font Bold 9";
    padding:       7px 0;
    border:        1px;
    border-color:  #725c5f55;
    border-radius: 14px;
    text-color:    @graphite;
    background-color: #ffffff99;
    cursor:        pointer;
}

button selected {
    border-color:     @ink;
    background-color: @cobalt;
    background-image: linear-gradient(to bottom, #f8aac0, #ee698e, #a51119, #dd1f41);
    text-color:       #ffffff;
}

message {
    padding:          10px 14px;
    border:           1px;
    border-color:     #725c5f55;
    border-radius:    14px;
    background-color: #ffffffb0;
}

textbox {
    text-color: @ink;
}

